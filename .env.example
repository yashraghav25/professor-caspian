# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Groq LLM
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Caspian SDK
CASPIAN_API_KEY=comm_sandbox_your_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=sentinel

# Alert delivery (mint key: curl -X POST https://api.trycaspianai.com/v1/projects/sandbox -d '{"name":"sentinel-ai"}')
INVESTOR_NOTIFY_EMAIL=investor@sentinel.ai
# Optional: address to contact if a HIGH/CRITICAL incident is not acknowledged.
# Defaults to INVESTOR_NOTIFY_EMAIL when empty.
ESCALATION_NOTIFY_EMAIL=
INVESTOR_TELEGRAM_CHAT_ID=

# Telegram Bot (from @BotFather — for instant HIGH/CRITICAL alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# End-of-day report hour (UTC, 24h)
DAILY_REPORT_HOUR=18

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Severity Thresholds
WARNING_PRICE_CHANGE=5
HIGH_PRICE_CHANGE=8
CRITICAL_PRICE_CHANGE=12
WARNING_PORTFOLIO_IMPACT=1
HIGH_PORTFOLIO_IMPACT=2
CRITICAL_PORTFOLIO_IMPACT=4

# Timing
ALERT_COOLDOWN_SECONDS=300
ESCALATION_DELAY_SECONDS=120
